<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:divider="?android:attr/dividerHorizontal"
        android:showDividers="middle">


        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Datos del Paquete"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:paddingBottom="8dp"/>

                <Spinner
                    android:id="@+id/spProductType"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:spinnerMode="dropdown"/>


                <Spinner
                    android:id="@+id/spPaymentMethod"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:spinnerMode="dropdown"/>

                <EditText
                    android:id="@+id/etDeclaredValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:hint="Valor declarado"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>


        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Datos de Recogida"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:paddingBottom="8dp"/>

                <EditText
                    android:id="@+id/etCityPickUp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Ciudad"/>

                <EditText
                    android:id="@+id/etTypeViaPickUp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Tipo de vía"/>

                <EditText
                    android:id="@+id/etNumberViaPickUp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Número de vía"/>

                <EditText
                    android:id="@+id/etApartmentPickUp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Apartamento (opcional)"/>

                <EditText
                    android:id="@+id/etBlockPickUp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Bloque (opcional)"/>

                <EditText
                    android:id="@+id/etInstructionsPickUp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Indicaciones adicionales"/>

                <EditText
                    android:id="@+id/etDatePickUp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:focusable="false"
                    android:hint="Fecha de recogida"/>

                <EditText
                    android:id="@+id/etHourPickUp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:focusable="false"
                    android:hint="Hora de recogida"/>

                <EditText
                    android:id="@+id/etAskForPickUp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Preguntar por"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>


        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Datos de Entrega"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:paddingBottom="8dp"/>

                <EditText
                    android:id="@+id/etCityDelivery"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Ciudad"/>

                <EditText
                    android:id="@+id/etTypeViaDelivery"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Tipo de vía"/>

                <EditText
                    android:id="@+id/etNumberViaDelivery"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Número de vía"/>

                <EditText
                    android:id="@+id/etApartmentDelivery"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Apartamento"/>

                <EditText
                    android:id="@+id/etBlockDelivery"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Bloque"/>

                <EditText
                    android:id="@+id/etInstructionsDelivery"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Indicaciones adicionales"/>

                <EditText
                    android:id="@+id/etAskForDelivery"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Preguntar por"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
        
        <Button
            android:id="@+id/btnRegisterDelivery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Registrar Pedido"
            android:textColor="@android:color/white"
            android:backgroundTint="@android:color/holo_blue_dark"
            android:layout_marginTop="16dp"/>
    </LinearLayout>
</ScrollView>