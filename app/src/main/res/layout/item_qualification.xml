<!-- res/layout/item_qualification.xml -->
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    card_view:cardCornerRadius="12dp"
    card_view:cardElevation="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Sección de la Orden -->
        <TextView
            android:id="@+id/tvOrderId"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Orden #123"
            android:textStyle="bold"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvProductType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Producto: Paquete" />

        <TextView
            android:id="@+id/tvPaymentMethod"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pago: Efectivo - $20.000" />

        <TextView
            android:id="@+id/tvRemitent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Remitente: Juan Pérez" />

        <TextView
            android:id="@+id/tvDeliveryLocation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Entrega: Bogotá, Calle 123 #45" />

        <TextView
            android:id="@+id/tvDeliveryDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Fecha entrega: 2025-10-08" />

        <!-- Sección de Calificación -->
        <TextView
            android:id="@+id/tvScore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Puntuación: 5"
            android:textStyle="bold"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/tvComment"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Comentario del usuario" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
